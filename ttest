-- Refresh List function
local function RefreshList(filter)
    List:ClearAllChildren()
    local layout = Instance.new("UIListLayout",List)
    layout.Padding=UDim.new(0,6)
    layout.SortOrder=Enum.SortOrder.LayoutOrder
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        List.CanvasSize=UDim2.new(0,0,0,layout.AbsoluteContentSize.Y)
    end)
    for _, name in ipairs(GetTargetNames()) do
        if not filter or name:lower():find(filter:lower()) then
            local btn = Instance.new("TextButton",List)
            btn.Size=UDim2.new(1,0,0,34)
            btn.Text=name
            btn.Font=Enum.Font.Gotham
            btn.TextSize=14
            btn.TextColor3=Color3.new(1,1,1)
            btn.ZIndex=53
            if name:find("%[BOSS%]") then btn.BackgroundColor3=Color3.fromRGB(200,50,50)
            elseif name=="Human" then btn.BackgroundColor3=Color3.fromRGB(50,100,200)
            else btn.BackgroundColor3=Color3.fromRGB(50,150,50) end
            Corner(btn,8)
            btn.MouseButton1Click:Connect(function()
                SelectedTarget=name
                TargetLabel.Text="TARGET : "..name
                Popup.Visible=false
            end)
        end
    end
end

