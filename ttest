--==================== BODY VELOCITY =================
local function EnableBV()
    if BV or not HRP then return end
    BV = Instance.new("BodyVelocity")
    BV.MaxForce = Vector3.new(1e9,1e9,1e9)
    BV.Velocity = Vector3.zero
    BV.Parent = HRP
end
local function DisableBV()
    if BV then BV:Destroy(); BV=nil end
end

--==================== TARGET LOGIC =================
local function GetTargetNames()
    local names = {}
    local added = {}
    local humanFound = false
    for _, m in ipairs(TargetFolder:GetChildren()) do
        if m:IsA("Model") and m:FindFirstChild("Humanoid") then
            local nm = m.Name
            if nm:lower():find("human") then humanFound=true
            elseif not added[nm] then table.insert(names,nm); added[nm]=true end
        end
    end
    if humanFound then table.insert(names,"Human") end
    local BossFolder = TargetFolder:FindFirstChild("Boss")
    if BossFolder then
        for _, boss in ipairs(BossFolder:GetChildren()) do
            if boss:IsA("Model") and boss:FindFirstChild("Humanoid") then
                local bossName="[BOSS] "..boss.Name
                if not added[bossName] then table.insert(names,bossName) end
            end
        end
    end
    return names
end

local function GetTargets(name)
    local t={}
    for _, m in ipairs(TargetFolder:GetChildren()) do
        if m:IsA("Model") and m:FindFirstChild("Humanoid") then
            if name=="Human" and m.Name:lower():find("human") then table.insert(t,m)
            elseif name==m.Name then table.insert(t,m) end
        end
    end
    local BossFolder=TargetFolder:FindFirstChild("Boss")
    if BossFolder then
        for _, boss in ipairs(BossFolder:GetChildren()) do
            if boss:IsA("Model") and boss:FindFirstChild("Humanoid") then
                local bossName="[BOSS] "..boss.Name
                if bossName==name then table.insert(t,boss) end
            end
        end
    end
    return t
end

--==================== ATTACK ======================
local function AttackTarget(model)
    local hum = model:FindFirstChild("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    local _, size = model:GetBoundingBox()
    local depth = (size.Y/2)+3
    while AutoAttack and hum.Health>0 do
        HRP.CFrame = root.CFrame * CFrame.new(0,-depth,0) * CFrame.Angles(math.rad(90),0,math.rad(90))
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        FireAttack()
        RunService.Heartbeat:Wait()
    end
end
task.spawn(function()
    while true do
        if AutoAttack and SelectedTarget then
            for _, target in ipairs(GetTargets(SelectedTarget)) do
                if not AutoAttack then break end
                AttackTarget(target)
            end
        end
        task.wait(1)
    end
end)

