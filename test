    local Layout = Instance.new("UIListLayout", List)
    Layout.Padding = UDim.new(0,6)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        List.CanvasSize = UDim2.new(0,0,0,Layout.AbsoluteContentSize.Y)
    end)

    for _, name in ipairs(GetTargetNames()) do
        if not filter or name:lower():find(filter:lower()) then
            local btn = Instance.new("TextButton", List)
            btn.Size = UDim2.new(1,0,0,34)
            btn.Text = name
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 14
            btn.TextColor3 = Color3.new(1,1,1)
            btn.ZIndex = 14

            -- สีตามประเภท
-- กำหนดสีปุ่มตามประเภท / ชื่อเฉพาะ
if name:find("%[BOSS%]") then
    btn.BackgroundColor3 = Color3.fromRGB(200,50,50)        -- BOSS แดง
elseif name == "Human" then
    btn.BackgroundColor3 = Color3.fromRGB(50,100,200)       -- Human น้ำเงิน
elseif name == "Player" then
    btn.BackgroundColor3 = Color3.fromRGB(255,165,0)        -- Player ส้ม
elseif name == "Athlete" then
    btn.BackgroundColor3 = Color3.fromRGB(50,100,200)
elseif name == "Bulk Ghoul" then
    btn.BackgroundColor3 = Color3.fromRGB(50,100,200)
elseif name == "First class Investigator" then
    btn.BackgroundColor3 = Color3.fromRGB(50,100,200)
elseif name == "Rank 1 Investigator" then
    btn.BackgroundColor3 = Color3.fromRGB(50,100,200)
elseif name == "Rank 2 Investigator" then
    btn.BackgroundColor3 = Color3.fromRGB(50,100,200)
elseif name == "Rin Ghoul" then
    btn.BackgroundColor3 = Color3.fromRGB(50,100,200)
elseif name == "Serpent Ghoul" then
    btn.BackgroundColor3 = Color3.fromRGB(50,150,50)        -- Serpent Ghoul เขียวเข้ม
else
    btn.BackgroundColor3 = Color3.fromRGB(50,150,50)        -- Default สำหรับ AI / Monster ที่เหลือ
end



            Corner(btn,8)

