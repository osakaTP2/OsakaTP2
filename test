--====================
-- SERVICES
--====================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Player = Players.LocalPlayer

--====================
-- CHARACTER (RESPAWN SAFE)
--====================
local Character, Humanoid, HRP
local DefaultHipHeight, DefaultAutoRotate

local function SetupChar(char)
	Character = char
	Humanoid = char:WaitForChild("Humanoid")
	HRP = char:WaitForChild("HumanoidRootPart")
	DefaultHipHeight = Humanoid.HipHeight
	DefaultAutoRotate = Humanoid.AutoRotate
end

SetupChar(Player.Character or Player.CharacterAdded:Wait())
Player.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	SetupChar(char)
end)

--====================
-- STATE
--====================
local SelectedTargetName = nil
local AutoAttack = false
local AutoUpgrade = false
local SelectedUpgrade = "Damage"
local NoClip = false
local BV = nil

--====================
-- NOCLIP
--====================
RunService.Stepped:Connect(function()
	if NoClip and Character then
		for _, v in ipairs(Character:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CanCollide = false
			end
		end
	end
end)

local function EnableBV()
	if BV or not HRP then return end
	BV = Instance.new("BodyVelocity")
	BV.MaxForce = Vector3.new(1e9,1e9,1e9)
	BV.Velocity = Vector3.zero
	BV.Parent = HRP
end

local function DisableBV()
	if BV then
		BV:Destroy()
		BV = nil
	end
end

--====================
-- ATTACK REMOTE
--====================
local function FireAttack()
	ReplicatedStorage:WaitForChild("BridgeNet2")
		:WaitForChild("dataRemoteEvent")
		:FireServer({
			"NormalAttack",
			"\n"
		})
end

--====================
-- TARGET LIST
--====================
local function GetTargetModels(name)
	local folder = Workspace:FindFirstChild("AI/Player")
	if not folder then return {} end

	local t = {}
	for _, m in ipairs(folder:GetChildren()) do
		if m:IsA("Model") and m.Name == name then
			local hum = m:FindFirstChild("Humanoid")
			local root = m:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				table.insert(t, m)
			end
		end
	end
	return t
end

--====================
-- ATTACK TARGET
--====================
local function AttackTarget(model)
	local hum = model:FindFirstChild("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end

	NoClip = true
	EnableBV()

	Humanoid.PlatformStand = true
	Humanoid.AutoRotate = false
	Humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	while AutoAttack and hum.Health > 0 do
		HRP.CFrame =
			root.CFrame
			* CFrame.new(0, -4, 0)
			* CFrame.Angles(math.rad(180), 0, math.rad(180))

		FireAttack()
		task.wait(0.15)
	end
end

--====================
-- AUTO ATTACK LOOP
--====================
task.spawn(function()
	while true do
		if AutoAttack and SelectedTargetName then
			for _, t in ipairs(GetTargetModels(SelectedTargetName)) do
				if not AutoAttack then break end
				AttackTarget(t)
				task.wait(math.random(3,5))
			end
		end
		task.wait(0.1)
	end
end)

--====================
-- AUTO UPGRADE
--====================
local function FireUpgrade(stat)
	ReplicatedStorage:WaitForChild("BridgeNet2")
		:WaitForChild("dataRemoteEvent")
		:FireServer({
			{
				{ stat, 1 },
				"\003"
			}
		})
end

task.spawn(function()
	while true do
		if AutoUpgrade then
			FireUpgrade(SelectedUpgrade)
		end
		task.wait(0.25)
	end
end)

--====================
-- QUEST (DYNAMIC REMOTE)
--====================
local function GetQuestRemote()
	for _, v in ipairs(ReplicatedStorage:WaitForChild("Network"):GetChildren()) do
		if v:IsA("RemoteEvent") then
			return v
		end
	end
end

local function RequestQuest(folder)
	local remote = GetQuestRemote()
	if not remote then return end

	local quest = ReplicatedStorage
		.Modules.Client.TalkNpc.Quests
		:WaitForChild(folder)
		:WaitForChild("Quest")

	remote:FireServer("RequestQuest", quest)
end

--====================
-- STOP ALL (OFF FIX)
--====================
local function StopAll()
	AutoAttack = false
	NoClip = false
	DisableBV()

	Humanoid.PlatformStand = false
	Humanoid.AutoRotate = DefaultAutoRotate
	Humanoid.HipHeight = DefaultHipHeight
	Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	task.wait()
	Humanoid:ChangeState(Enum.HumanoidStateType.Running)
end

