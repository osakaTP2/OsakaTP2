-- UPGRADE SELECT
local upgradeLabel = MakeButton("📂 Upgrade : Damage", 198)
upgradeLabel.MouseButton1Click:Connect(function()
	local order = {"Damage","Durability","Stamina","Speed"}
	for i,v in ipairs(order) do
		if v == SelectedUpgrade then
			SelectedUpgrade = order[i % #order + 1]
			break
		end
	end
	upgradeLabel.Text = "📂 Upgrade : "..SelectedUpgrade
end)

