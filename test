local search = Instance.new("TextBox", listWin)
search.Size = UDim2.new(1,-20,0,30)
search.Position = UDim2.fromOffset(10,10)
search.PlaceholderText = "Search..."
search.Font = Enum.Font.Gotham
search.TextSize = 14

local scroll = Instance.new("ScrollingFrame", listWin)
scroll.Size = UDim2.new(1,-20,1,-60)
scroll.Position = UDim2.fromOffset(10,50)
scroll.CanvasSize = UDim2.new()
scroll.ScrollBarThickness = 6
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y

local layout = Instance.new("UIListLayout", scroll)
layout.Padding = UDim.new(0,6)

local function RefreshList()
	scroll:ClearAllChildren()
	layout.Parent = scroll

	local folder = Workspace:FindFirstChild("AI/Player")
	if not folder then return end

	for _, m in ipairs(folder:GetChildren()) do
		if search.Text == "" or m.Name:lower():find(search.Text:lower()) then
			local b = Instance.new("TextButton", scroll)
			b.Size = UDim2.new(1,0,0,34)
			b.Text = m.Name
			b.Font = Enum.Font.Gotham
			b.TextSize = 14
			b.BackgroundColor3 = Color3.fromRGB(55,55,55)
			b.TextColor3 = Color3.new(1,1,1)
			Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)

			b.MouseButton1Click:Connect(function()
				SelectedTargetName = m.Name
			end)
		end
	end
end

search:GetPropertyChangedSignal("Text"):Connect(RefreshList)
RefreshList()
